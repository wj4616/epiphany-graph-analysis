{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "epiphany-graph-analysis graph schema",
  "description": "JSON Schema for validating epiphany-graph-analysis graph.json topology files.",
  "type": "object",
  "required": ["version", "skill_name", "kb_base", "session_output_base", "nodes", "edges"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Semantic version of this graph topology."
    },
    "skill_name": {
      "type": "string",
      "description": "Skill identifier."
    },
    "kb_base": {
      "type": "string",
      "description": "Base path for KB files."
    },
    "session_output_base": {
      "type": "string",
      "description": "Default session output directory."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/edge"
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "module_file",
        "module_version",
        "type",
        "exec_type",
        "hat",
        "kb_files",
        "context_budget_lines",
        "scale_gates",
        "activation",
        "enabled_when",
        "input_dependencies",
        "output_file",
        "required_output_sections",
        "raises_signals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^N[0-9]+$",
          "description": "Node identifier (e.g. N1, N2, N12)."
        },
        "module_file": {
          "type": "string",
          "description": "Relative path to the module markdown file."
        },
        "module_version": {
          "type": "string",
          "description": "Semantic version of the module file."
        },
        "type": {
          "type": "string",
          "enum": [
            "DECOMPOSITION",
            "ANALYZE",
            "TAILOR",
            "XREF",
            "LATERAL",
            "DEFIXATION",
            "ADVERSARIAL",
            "ENGINEER",
            "ROUTER",
            "SYNTHESIS",
            "VERIFICATION",
            "EXPANSION"
          ],
          "description": "Node type from taxonomy."
        },
        "exec_type": {
          "type": "string",
          "enum": ["inline", "spawn"],
          "description": "Whether the node runs inline in orchestrator context or as an Agent spawn."
        },
        "hat": {
          "type": ["string", "null"],
          "description": "Cognitive persona(s) for this node. null for router nodes."
        },
        "kb_files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of KB filenames to load from kb_base."
        },
        "context_budget_lines": {
          "type": "integer",
          "minimum": 1,
          "description": "Estimated line budget for this node's context."
        },
        "scale_gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["MINIMAL", "STANDARD", "DEEP"]
          },
          "description": "Which scale modes activate this node."
        },
        "activation": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Activation conditions for this node."
        },
        "enabled_when": {
          "type": ["string", "null"],
          "description": "Additional condition for enabling this node."
        },
        "input_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Stage file paths this node reads from disk."
        },
        "output_file": {
          "type": "string",
          "description": "Relative path (from session_dir) for this node's output stage file."
        },
        "required_output_sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Section headers that must appear in the output file."
        },
        "raises_signals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Signal IDs this node may raise in its output digest."
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "type",
        "signal_field",
        "scale_gates",
        "gate_condition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Edge identifier (e.g. E01, E24)."
        },
        "source": {
          "type": "string",
          "description": "Source node ID or 'input' sentinel."
        },
        "target": {
          "type": "string",
          "description": "Target node ID or 'output' sentinel."
        },
        "type": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "back-edge",
            "gate-open",
            "forward-conditional",
            "terminal"
          ],
          "description": "Edge type from taxonomy."
        },
        "signal_field": {
          "type": "string",
          "description": "Signal field name, gate literal (gate:...), or em-dash sentinel."
        },
        "scale_gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["MINIMAL", "STANDARD", "DEEP"]
          },
          "description": "Which scale modes include this edge."
        },
        "gate_condition": {
          "type": ["string", "null"],
          "description": "Gate condition expression, or null for unconditional edges."
        }
      },
      "additionalProperties": false
    }
  }
}
